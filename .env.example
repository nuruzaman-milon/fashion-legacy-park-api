NODE_ENV=development
PORT=5000

# PostgreSQL connection string — required.
# Read by prisma/schema.prisma and prisma.config.ts
# Local Postgres:
DATABASE_URL="postgresql://user:password@localhost:5432/aydin_bazar?schema=public"
# Prisma Postgres / Accelerate:
# DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY_HERE"

# JWT secrets — required, minimum 32 characters each.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars

# Access tokens are stateless and cannot be revoked, so keep this short.
JWT_ACCESS_EXPIRES_IN=15m

# Refresh tokens live in the database and are revocable.
REFRESH_TOKEN_TTL_DAYS=30

# Email/password token lifetimes, in minutes.
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60

# bcrypt work factor (10–15). Higher is slower and safer.
BCRYPT_ROUNDS=12

# Frontend origin. Used for the CORS allow-list and for links inside emails.
CLIENT_URL=http://localhost:3000

# Seed the first SUPER_ADMIN (npm run db:seed).
# Without this there is no way into the admin surface — registration always
# creates a CUSTOMER, and changing a role requires an existing SUPER_ADMIN.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-seeding
SEED_ADMIN_NAME=Super Admin

# Cloudinary — optional. Avatar upload is disabled unless all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
