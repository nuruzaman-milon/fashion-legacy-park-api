generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  ADMIN
  CUSTOMER
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id     String  @id @default(cuid())
  name   String
  email  String  @unique
  phone  String? @unique
  avatar String?

  role Role @default(CUSTOMER)

  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts      Account[]
  refreshTokens RefreshToken[]

  addresses     Address[]
  cart          Cart?
  wishlists     Wishlist[]
  reviews       Review[]
  orders            Order[]
  notifications     Notification[]
  couponRedemptions CouponRedemption[]

  @@index([role])
}

//////////////////////////////////////////////////////
// ACCOUNT
//////////////////////////////////////////////////////

model Account {
  id String @id @default(cuid())

  userId String

  provider AuthProvider

  providerAccountId String?

  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Fully non-null, so this actually constrains. Without it, Postgres NULLS
  // DISTINCT lets a user hold unlimited EMAIL accounts (providerAccountId is
  // NULL for those), each with its own password hash — meaning an old password
  // could keep authenticating, with the winner decided by the query planner.
  @@unique([userId, provider])
  // Still correct for OAuth: providerAccountId is non-null there, so this does
  // stop two users claiming the same Google/Facebook identity. It is only the
  // NULL (EMAIL) case it cannot constrain, which the unique above now covers.
  @@unique([provider, providerAccountId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// REFRESH TOKEN
//////////////////////////////////////////////////////

model RefreshToken {
  id String @id @default(cuid())

  token String @unique

  userId String

  expiresAt DateTime

  revoked Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// PRODUCT STATUS
//////////////////////////////////////////////////////

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id String @id @default(cuid())

  name String

  slug String @unique

  description String?

  icon String?

  image String?

  banner String?

  parentId String?

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  metaTitle String?

  metaDescription String?

  metaKeywords String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Restrict, not the Prisma default SetNull: deleting a parent would silently
  // promote its whole subtree to root and reorganise the homepage nav.
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)

  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId])
  @@index([sortOrder])
}

//////////////////////////////////////////////////////
// BRAND
//////////////////////////////////////////////////////

model Brand {
  id String @id @default(cuid())

  name String

  slug String @unique

  logo String?

  description String?

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  metaTitle String?

  metaDescription String?

  metaKeywords String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  products Product[]

  @@index([sortOrder])
}

//////////////////////////////////////////////////////
// PRODUCT
//////////////////////////////////////////////////////

model Product {
  id String @id @default(cuid())

  categoryId String

  brandId String?

  name String

  slug String @unique

  shortDescription String?

  description String?

  videoUrl String?

  specifications Json?

  tags String[] @default([])

  isFeatured Boolean @default(false)

  status ProductStatus @default(DRAFT)

  viewCount Int @default(0)

  metaTitle String?

  metaDescription String?

  metaKeywords String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])

  brand Brand? @relation(fields: [brandId], references: [id])

  images ProductImage[]

  variants ProductVariant[]

  reviews Review[]

  wishlists Wishlist[]

  orderItems OrderItem[]

  @@index([brandId])
  @@index([categoryId, status])
  @@index([status, isFeatured, createdAt(sort: Desc)])
  // NOTE: there is deliberately no index on `name`. Search issues
  // ILIKE '%term%', and a leading wildcard makes a btree unusable — the old
  // @@index([name]) looked like search support while providing none. A pg_trgm
  // index would fix it, but Prisma Postgres denies CREATE EXTENSION (42501),
  // so text search is currently unindexed. See FEATURE.md → Search.
  @@index([tags], type: Gin)
}

//////////////////////////////////////////////////////
// PRODUCT IMAGE
//////////////////////////////////////////////////////

model ProductImage {
  id String @id @default(cuid())

  productId String

  url String

  alt String?

  sortOrder Int @default(0)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

//////////////////////////////////////////////////////
// PRODUCT VARIANT
//////////////////////////////////////////////////////

model ProductVariant {
  id String @id @default(cuid())

  productId String

  name String

  sku String @unique

  barcode String?

  price Decimal @db.Decimal(10, 2)

  comparePrice Decimal? @db.Decimal(10, 2)

  costPrice Decimal? @db.Decimal(10, 2)

  stock Int @default(0)

  weight Decimal? @db.Decimal(8, 2)

  imageUrl String?

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems CartItem[]

  orderItems     OrderItem[]
  flashSaleItems FlashSaleItem[]

  @@unique([productId, name])
  @@index([price])
  @@index([stock])
  // isDefault is enforced by a partial unique index added in the migration,
  // which also serves the "default variant for product X" lookup.
  @@index([productId, isActive])
}

//////////////////////////////////////////////////////
// DISCOUNT
//////////////////////////////////////////////////////

enum DiscountType {
  PERCENTAGE
  FIXED
}

//////////////////////////////////////////////////////
// ADDRESS
//////////////////////////////////////////////////////

model Address {
  id String @id @default(cuid())

  userId String

  receiverName String

  phone String

  label String?

  division String

  district String

  upazila String

  area String?

  address String

  postalCode String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([userId])
}

//////////////////////////////////////////////////////
// CART
//////////////////////////////////////////////////////

model Cart {
  id String @id @default(cuid())

  userId String @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]
}

//////////////////////////////////////////////////////
// CART ITEM
//////////////////////////////////////////////////////

model CartItem {
  id String @id @default(cuid())

  cartId String

  variantId String

  quantity Int @default(1)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Carts are disposable — an abandoned cart must not block deleting a product.
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

//////////////////////////////////////////////////////
// WISHLIST
//////////////////////////////////////////////////////

model Wishlist {
  id String @id @default(cuid())

  userId String

  productId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

//////////////////////////////////////////////////////
// COUPON
//////////////////////////////////////////////////////

model Coupon {
  id String @id @default(cuid())

  name String

  code String @unique

  description String?

  discountType DiscountType

  discountValue Decimal @db.Decimal(10, 2)

  minimumOrderAmount Decimal? @db.Decimal(10, 2)

  maximumDiscount Decimal? @db.Decimal(10, 2)

  totalUsageLimit Int?

  usedCount Int @default(0)

  perUserLimit Int @default(1)

  startsAt DateTime?

  expiresAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]

  applyWithFlashSale Boolean @default(false)

  @@index([startsAt])
  @@index([expiresAt])
  @@index([isActive, expiresAt])
}

// Redemption ledger. Replaces the old UserCoupon.usedCount counter, which was
// a bare integer with no link to the orders that consumed it — a cancelled
// order's decrement was a blind guess, and a crash mid-flow left permanent,
// undetectable drift. Here both Coupon.usedCount and the per-user count are
// derivable, and replay is race-safe by unique violation rather than
// read-then-write.
model CouponRedemption {
  id String @id @default(cuid())

  couponId String

  userId String

  orderId String

  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // A replayed checkout cannot double-count.
  @@unique([couponId, orderId])
  // Serves the perUserLimit check.
  @@index([couponId, userId])
  @@index([userId])
  @@index([orderId])
}

//////////////////////////////////////////////////////
// FLASH SALE
//////////////////////////////////////////////////////

model FlashSale {
  id String @id @default(cuid())

  title String

  description String?

  banner String?

  startsAt DateTime

  endsAt DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  items FlashSaleItem[]

  // Serves "sales live right now" — the only query that matters here.
  @@index([isActive, startsAt, endsAt])
}

//////////////////////////////////////////////////////
// FLASH SALE ITEM
//////////////////////////////////////////////////////

model FlashSaleItem {
  id String @id @default(cuid())

  flashSaleId String

  variantId String

  salePrice Decimal @db.Decimal(10, 2)

  quantityLimit Int?

  soldCount Int @default(0)

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)

  // Reach the product via variant.product. A separate productId was derivable
  // from the variant and nothing kept the two in agreement, so the storefront
  // badge query and the cart pricing path could disagree.
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, variantId])
  @@index([flashSaleId])
  @@index([variantId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

enum PaymentMethod {
  COD
  BKASH
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

//////////////////////////////////////////////////////
// ORDER
//////////////////////////////////////////////////////

model Order {
  id String @id @default(cuid())

  email String

  phone String

  userId String

  // Provenance only. The ship* fields below are the authoritative destination —
  // Address is user-editable, so a live FK would rewrite historical orders.
  addressId String?

  shipReceiverName String

  shipPhone String

  shipDivision String

  shipDistrict String

  shipUpazila String

  shipArea String?

  shipAddress String

  shipPostalCode String?

  couponId String?

  // Snapshotted so a deleted coupon cannot erase the provenance of `discount`.
  couponCode String?

  couponDiscountType DiscountType?

  couponDiscountValue Decimal? @db.Decimal(10, 2)

  invoiceNo String @unique

  subtotal Decimal @db.Decimal(10, 2)

  discount Decimal @default(0) @db.Decimal(10, 2)

  shippingCharge Decimal @default(0) @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod

  paymentStatus PaymentStatus @default(PENDING)

  orderStatus OrderStatus @default(PENDING)

  trackingNumber String?

  note String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  address Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  coupon Coupon? @relation(fields: [couponId], references: [id])

  items OrderItem[]

  couponRedemptions CouponRedemption[]

  // One row per attempt: a failed bKash try, the retry, then a refund all
  // coexist instead of overwriting each other. Order.paymentStatus is a
  // derived cache of the resolved state.
  payments Payment[]

  @@index([addressId])
  @@index([couponId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([orderStatus, createdAt(sort: Desc)])
}

//////////////////////////////////////////////////////
// ORDER ITEM
//////////////////////////////////////////////////////

model OrderItem {
  id String @id @default(cuid())

  orderId String

  // Nullable so a discontinued variant can be deleted. Order history survives
  // on the title/sku/unitPrice/image snapshots below; productId keeps the item
  // traceable to a product once variantId is gone.
  variantId String?

  productId String?

  quantity Int

  title String

  sku String

  unitPrice Decimal @db.Decimal(10, 2)

  totalPrice Decimal @db.Decimal(10, 2)

  image String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id String @id @default(cuid())

  orderId String

  amount Decimal @db.Decimal(10, 2)

  method PaymentMethod

  status PaymentStatus

  // Idempotency key: bKash and SSLCommerz both retry IPN callbacks on non-2xx,
  // so replayed webhooks must collide rather than insert a duplicate.
  transactionId String? @unique

  gatewayResponse Json?

  paidAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
}

//////////////////////////////////////////////////////
// REVIEW
//////////////////////////////////////////////////////

model Review {
  id String @id @default(cuid())

  userId String

  productId String

  rating Int

  comment String?

  images String[] @default([])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

enum NotificationType {
  SYSTEM
  ORDER
  PAYMENT
  PROMOTION
}

model Notification {
  id String @id @default(cuid())

  link String?

  userId String

  title String

  message String

  type NotificationType

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
}

//////////////////////////////////////////////////////
// BANNER
//////////////////////////////////////////////////////

model Banner {
  id String @id @default(cuid())

  title String

  desktopImageUrl String

  mobileImageUrl String?

  buttonText String?

  buttonLink String?

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

//////////////////////////////////////////////////////
// SETTINGS
//////////////////////////////////////////////////////

model Setting {
  // Singleton. A CHECK constraint in the migration pins this to one row —
  // otherwise findFirst() has no ORDER BY and identical carts could resolve
  // different shipping charges depending on which row the planner returns.
  id String @id @default("singleton")

  storeName String?

  logo String?

  favicon String?

  supportEmail String?

  supportPhone String?

  facebook String?

  instagram String?

  youtube String?

  tiktok String?

  whatsapp String?

  currency String?

  currencySymbol String?

  insideDhakaShippingCharge Decimal? @db.Decimal(10, 2)

  outsideDhakaShippingCharge Decimal? @db.Decimal(10, 2)

  freeShippingMinimumAmount Decimal? @db.Decimal(10, 2)

  facebookPixelId String?

  googleAnalyticsId String?

  maintenanceMode Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
