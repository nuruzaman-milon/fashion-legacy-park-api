generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  ADMIN
  CUSTOMER
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  avatar        String?

  role         Role     @default(CUSTOMER)

  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  accounts      Account[]
  refreshTokens RefreshToken[]

  addresses      Address[]
  cart           Cart?
  wishlists      Wishlist[]
  reviews        Review[]
  orders         Order[]
  notifications  Notification[]
  userCoupons UserCoupon[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

//////////////////////////////////////////////////////
// ACCOUNT
//////////////////////////////////////////////////////

model Account {
  id                  String         @id @default(cuid())

  userId              String

  provider            AuthProvider

  providerAccountId   String?

  password            String?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId])

  @@unique([provider, providerAccountId])
}

//////////////////////////////////////////////////////
// REFRESH TOKEN
//////////////////////////////////////////////////////

model RefreshToken {
  id          String   @id @default(cuid())

  token       String   @unique

  userId      String

  expiresAt   DateTime

  revoked     Boolean  @default(false)

  createdAt   DateTime @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId])

  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// PRODUCT STATUS
//////////////////////////////////////////////////////

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {

  id                String      @id @default(cuid())

  name              String

  slug              String      @unique

  description       String?

  icon              String?

  image             String?

  banner            String?

  parentId          String?

  sortOrder         Int         @default(0)

  isActive          Boolean     @default(true)

  metaTitle         String?

  metaDescription   String?

  metaKeywords      String?

  createdAt         DateTime    @default(now())

  updatedAt         DateTime    @updatedAt

  parent            Category?   @relation("CategoryTree", fields: [parentId], references: [id])

  children          Category[]  @relation("CategoryTree")

  products          Product[]

  @@index([parentId])

  @@index([slug])

  @@index([sortOrder])
}

//////////////////////////////////////////////////////
// BRAND
//////////////////////////////////////////////////////

model Brand {

  id                String      @id @default(cuid())

  name              String

  slug              String      @unique

  logo              String?

  description       String?

  sortOrder         Int         @default(0)

  isActive          Boolean     @default(true)

  metaTitle         String?

  metaDescription   String?

  metaKeywords      String?

  createdAt         DateTime    @default(now())

  updatedAt         DateTime    @updatedAt

  products          Product[]

  @@index([slug])

  @@index([sortOrder])
}

//////////////////////////////////////////////////////
// PRODUCT
//////////////////////////////////////////////////////

model Product {

  id                  String          @id @default(cuid())

  categoryId          String

  brandId             String?

  name                String

  slug                String          @unique

  shortDescription    String?

  description         String?

  videoUrl            String?

  specifications      Json?

  tags                String[]

  isFeatured          Boolean         @default(false)

  status              ProductStatus   @default(DRAFT)

  metaTitle           String?

  metaDescription     String?

  metaKeywords        String?

  createdAt           DateTime        @default(now())

  updatedAt           DateTime        @updatedAt

  category            Category @relation(
    fields: [categoryId],
    references: [id]
  )

  brand               Brand? @relation(
    fields: [brandId],
    references: [id]
  )

  images              ProductImage[]

  variants            ProductVariant[]

  reviews             Review[]

  wishlists           Wishlist[]

  flashSaleItems      FlashSaleItem[]

  @@index([categoryId])

  @@index([brandId])

  @@index([status])

  @@index([slug])
}

//////////////////////////////////////////////////////
// PRODUCT IMAGE
//////////////////////////////////////////////////////

model ProductImage {

  id             String      @id @default(cuid())

  productId      String

  image          String

  alt            String?

  sortOrder      Int         @default(0)

  isPrimary      Boolean     @default(false)

  createdAt      DateTime    @default(now())

  product Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  @@index([productId])
}

//////////////////////////////////////////////////////
// PRODUCT VARIANT
//////////////////////////////////////////////////////

model ProductVariant {

  id              String      @id @default(cuid())

  productId       String

  title           String

  sku             String      @unique

  barcode         String?

  price           Decimal

  comparePrice    Decimal?

  costPrice       Decimal?

  stock           Int         @default(0)

  weight          Float?

  image           String?

  isDefault       Boolean     @default(false)

  createdAt       DateTime    @default(now())

  updatedAt       DateTime    @updatedAt

  product Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  cartItems       CartItem[]

  orderItems      OrderItem[]

  @@index([productId])

  @@index([sku])

  @@index([price])

  @@index([stock])
}

//////////////////////////////////////////////////////
// DISCOUNT
//////////////////////////////////////////////////////

enum DiscountType {
  PERCENTAGE
  FIXED
}

//////////////////////////////////////////////////////
// ADDRESS
//////////////////////////////////////////////////////

model Address {

  id                String      @id @default(cuid())

  userId            String

  fullName          String

  phone             String

  label             String?

  division          String

  district          String

  upazila           String

  area              String?

  address           String

  postalCode        String?

  isDefault         Boolean     @default(false)

  createdAt         DateTime    @default(now())

  updatedAt         DateTime    @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  orders Order[]

  @@index([userId])
}

//////////////////////////////////////////////////////
// CART
//////////////////////////////////////////////////////

model Cart {

  id                String      @id @default(cuid())

  userId            String      @unique

  createdAt         DateTime    @default(now())

  updatedAt         DateTime    @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  items CartItem[]
}

//////////////////////////////////////////////////////
// CART ITEM
//////////////////////////////////////////////////////

model CartItem {

  id                String      @id @default(cuid())

  cartId            String

  variantId         String

  quantity          Int         @default(1)

  createdAt         DateTime    @default(now())

  updatedAt         DateTime    @updatedAt

  cart Cart @relation(
    fields: [cartId],
    references: [id],
    onDelete: Cascade
  )

  variant ProductVariant @relation(
    fields: [variantId],
    references: [id]
  )

  @@unique([cartId, variantId])

  @@index([variantId])
}

//////////////////////////////////////////////////////
// WISHLIST
//////////////////////////////////////////////////////

model Wishlist {

  id                String      @id @default(cuid())

  userId            String

  productId         String

  createdAt         DateTime    @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  product Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([userId, productId])

  @@index([userId])

  @@index([productId])
}

//////////////////////////////////////////////////////
// COUPON
//////////////////////////////////////////////////////

model Coupon {

  id                  String          @id @default(cuid())

  code                String          @unique

  description         String?

  discountType        DiscountType

  discountValue       Decimal

  minimumOrderAmount  Decimal?

  maximumDiscount     Decimal?

  totalUsageLimit     Int?

  usedCount           Int             @default(0)

  perUserLimit        Int             @default(1)

  startsAt            DateTime?

  expiresAt           DateTime?

  isActive            Boolean         @default(true)

  createdAt           DateTime        @default(now())

  updatedAt           DateTime        @updatedAt

  orders              Order[]
  userCoupons         UserCoupon[]

  applyWithFlashSale Boolean @default(false)

  @@index([code])

  @@index([startsAt])

  @@index([expiresAt])
}
// user coupon
model UserCoupon {
  id         String   @id @default(cuid())

  userId     String
  couponId   String

  usedCount  Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  coupon Coupon @relation(
    fields: [couponId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([userId, couponId])

  @@index([userId])

  @@index([couponId])
}

//////////////////////////////////////////////////////
// FLASH SALE
//////////////////////////////////////////////////////

model FlashSale {

  id                String      @id @default(cuid())

  title             String

  description       String?

  banner            String?

  startsAt          DateTime

  endsAt            DateTime

  isActive          Boolean     @default(true)

  createdAt         DateTime    @default(now())

  updatedAt         DateTime    @updatedAt

  items FlashSaleItem[]
}

//////////////////////////////////////////////////////
// FLASH SALE ITEM
//////////////////////////////////////////////////////

model FlashSaleItem {

  id                  String      @id @default(cuid())

  flashSaleId         String

  productId           String

  variantId           String

  salePrice           Decimal

  quantityLimit       Int?

  soldCount           Int         @default(0)

  flashSale FlashSale @relation(
    fields: [flashSaleId],
    references: [id],
    onDelete: Cascade
  )

  product Product @relation(
    fields: [productId],
    references: [id]
  )

  variant ProductVariant @relation(
    fields: [variantId],
    references: [id]
  )

  @@unique([flashSaleId, variantId])

  @@index([flashSaleId])

  @@index([variantId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

enum PaymentMethod {
  COD
  BKASH
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

//////////////////////////////////////////////////////
// ORDER
//////////////////////////////////////////////////////

model Order {

  id                  String          @id @default(cuid())

  userId              String

  addressId           String

  couponId            String?

  invoiceNo           String          @unique

  subtotal            Decimal

  discount            Decimal         @default(0)

  shippingCharge      Decimal         @default(0)

  total               Decimal

  paymentMethod       PaymentMethod

  paymentStatus       PaymentStatus   @default(PENDING)

  orderStatus         OrderStatus     @default(PENDING)

  trackingNumber      String?

  note                String?

  createdAt           DateTime        @default(now())

  updatedAt           DateTime        @updatedAt

  user User @relation(
    fields:[userId],
    references:[id]
  )

  address Address @relation(
    fields:[addressId],
    references:[id]
  )

  coupon Coupon? @relation(
    fields:[couponId],
    references:[id]
  )

  items OrderItem[]

  payment Payment?

  @@index([userId])

  @@index([couponId])

  @@index([orderStatus])

  @@index([paymentStatus])
}

//////////////////////////////////////////////////////
// ORDER ITEM
//////////////////////////////////////////////////////

model OrderItem {

  id                String      @id @default(cuid())

  orderId           String

  variantId         String

  quantity          Int

  title             String

  sku               String

  unitPrice         Decimal

  totalPrice        Decimal

  image             String?

  createdAt         DateTime    @default(now())

  order Order @relation(
    fields:[orderId],
    references:[id],
    onDelete:Cascade
  )

  variant ProductVariant @relation(
    fields:[variantId],
    references:[id]
  )

  @@index([orderId])

  @@index([variantId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {

  id                  String            @id @default(cuid())

  orderId             String            @unique

  amount              Decimal

  method              PaymentMethod

  status              PaymentStatus

  transactionId       String?

  gatewayResponse     Json?

  paidAt              DateTime?

  createdAt           DateTime          @default(now())

  updatedAt           DateTime          @updatedAt

  order Order @relation(
    fields:[orderId],
    references:[id],
    onDelete:Cascade
  )
}

//////////////////////////////////////////////////////
// REVIEW
//////////////////////////////////////////////////////

model Review {

  id                String      @id @default(cuid())

  userId            String

  productId         String

  rating            Int

  comment           String?

  images            String[]

  createdAt         DateTime    @default(now())

  updatedAt         DateTime    @updatedAt

  user User @relation(
    fields:[userId],
    references:[id]
  )

  product Product @relation(
    fields:[productId],
    references:[id],
    onDelete:Cascade
  )

  @@unique([userId, productId])

  @@index([productId])
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

enum NotificationType {
  SYSTEM
  ORDER
  PAYMENT
  PROMOTION
}

model Notification {

  id                String      @id @default(cuid())

  userId            String

  title             String

  message           String

  type              NotificationType

  isRead            Boolean     @default(false)

  createdAt         DateTime    @default(now())

  user User @relation(
    fields:[userId],
    references:[id],
    onDelete:Cascade
  )

  @@index([userId])

}

//////////////////////////////////////////////////////
// BANNER
//////////////////////////////////////////////////////

model Banner {

  id                String      @id @default(cuid())

  title             String

  desktopImage      String

  mobileImage       String?

  buttonText        String?

  buttonLink        String?

  sortOrder         Int         @default(0)

  isActive          Boolean     @default(true)

  createdAt         DateTime    @default(now())

  updatedAt         DateTime    @updatedAt
}

//////////////////////////////////////////////////////
// SETTINGS
//////////////////////////////////////////////////////

model Setting {

  id                            String      @id @default(cuid())

  storeName                     String?

  logo                          String?

  favicon                       String?

  supportEmail                  String?

  supportPhone                  String?

  facebook                      String?

  instagram                     String?

  youtube                       String?

  tiktok                        String?

  whatsapp                      String?

  currency                      String?

  currencySymbol                String?

  defaultShippingCharge         Decimal?

  freeShippingMinimumAmount     Decimal?

  facebookPixelId               String?

  googleAnalyticsId             String?

  maintenanceMode               Boolean     @default(false)

  createdAt                     DateTime    @default(now())

  updatedAt                     DateTime    @updatedAt
}